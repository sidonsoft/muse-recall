{
  // One-click judge environment: installs dependencies, seeds the recorded demo
  // project and starts the app on the deterministic offline provider. No Muse
  // account, API key or secret is needed. See .devcontainer/README.md.
  "name": "Muse Recall",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "pnpm dev",
  "forwardPorts": [5173, 8787],
  "portsAttributes": {
    "5173": {
      "label": "Muse Recall (web)",
      "onAutoForward": "openBrowser"
    },
    "8787": {
      "label": "API (reached through the web proxy)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [".devcontainer/README.md"]
    },
    "vscode": {
      "extensions": ["biomejs.biome"]
    }
  }
}
