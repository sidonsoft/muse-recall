{
  // One-click judge environment: installs dependencies, verifies the app runs
  // on the deterministic offline provider, and seeds the recorded demo
  // project. No Muse account, API key or secret is needed. See
  // .devcontainer/README.md. Ports stay private and the API stays loopback-only.
  "name": "Muse Recall",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "postAttachCommand": "bash .devcontainer/status.sh",
  "forwardPorts": [5173, 8787],
  "portsAttributes": {
    "5173": {
      "label": "Muse Recall (web)",
      "onAutoForward": "openBrowser"
    },
    "8787": {
      "label": "API (reached through the web proxy)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [".devcontainer/README.md"]
    },
    "vscode": {
      "extensions": ["biomejs.biome"]
    }
  }
}
