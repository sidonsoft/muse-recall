# ---------------------------------------------------------------------------
# Muse Memory Lab — environment configuration
# Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# Bind address for the Fastify API. Keep on loopback for a local-first app.
HOST=127.0.0.1
PORT=8787
# Node environment: development | test | production
NODE_ENV=development
# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Persistence ----------------------------------------------------------
# SQLite file. Relative paths resolve against the repository root.
DATABASE_PATH=./data/muse-memory-lab.db
# Enable SQLite WAL journaling (recommended for the local server).
SQLITE_WAL=true

# --- Muse provider --------------------------------------------------------
# Which model provider the harness uses: muse-cli | echo
# `echo` is a deterministic offline provider used by tests and by CI.
MODEL_PROVIDER=muse-cli
# Muse CLI binary. Resolved from PATH when unset.
MUSE_BIN=muse
# Muse model id (see `muse model-profile`, or docs/muse-integration.md).
MUSE_MODEL=muse-wonder-1.0
# Reasoning effort: none | minimal | low | medium | high | xhigh | max | ultra
MUSE_REASONING_EFFORT=medium
# Hard timeout for a single headless Muse invocation, in milliseconds.
MUSE_TIMEOUT_MS=120000
# Optional: Meta API key. If unset, the Muse CLI uses its stored login.
# META_API_KEY=

# --- Memory retrieval -----------------------------------------------------
# Budgets are configuration, not architecture: raise them for deep recall.
MEMORY_MAX_MEMORIES=8
MEMORY_MAX_CHARACTERS=4000
MEMORY_MAX_MEMORY_CHARACTERS=1000
# Mark memories past their expiry as expired when the server starts.
MEMORY_SWEEP_ON_START=true

# --- Conversation context (Phase 3) ---------------------------------------
# Hard caps for the assembled application prompt. The current request is never
# truncated; older history is dropped first.
CONTEXT_MAX_HISTORY_MESSAGES=8
CONTEXT_MAX_HISTORY_CHARACTERS=6000
CONTEXT_MAX_PROMPT_CHARACTERS=24000
CONTEXT_MAX_MESSAGE_CHARACTERS=8000
CONTEXT_MAX_CORRECTION_HISTORY=3
AGENT_MAX_OUTPUT_TOKENS=1200
# off | suggest: "suggest" proposes memory candidates for confirmation; it never
# stores them automatically. Explicit "remember ..." commands are always honoured.
MEMORY_AUTO_CAPTURE=suggest

# --- Agent tools (Phase 5) ------------------------------------------------
TOOLS_ENABLED=true
# always = reads run immediately, writes need explicit approval
TOOL_APPROVAL_POLICY=always
TOOL_MAX_CALLS_PER_TURN=3
# auto = decide only for action-like messages; always = every turn; off = disabled
TOOL_DECISION_MODE=auto

# --- Quota failover (optional) --------------------------------------------
# Subscription first; API key only when the CLI reports quota exhaustion.
# Keys are passed over stdin and are never logged.
# MUSE_FALLBACK_API_KEY=...
MUSE_FALLBACK_MODEL=muse-spark-1.3-contributor
# FORGE_FALLBACK_API_KEY=...
FORGE_FALLBACK_MODEL=muse-spark-1.3-contributor

# --- Safety ---------------------------------------------------------------
# Tool approval policy for agent tool calls: always | never
TOOL_APPROVAL_POLICY=always
# Workspace root that project file tools are confined to.
WORKSPACE_ROOT=./workspaces
