// Staged artifact for post-judging action B-7 (test typechecking in CI).
// NOT wired: no script and no CI step references this yet, so current gates are
// unaffected. History of the denominator: 31 Oct first run 270 -> 261 with module
// mappings complete (@mml/agent-core, @mml/ui-protocol, fastify via apps/server's
// deps - pnpm does not hoist it to root) -> 254 with allowImportingTsExtensions on
// (noEmit-only; .ts specifiers are the vite/tsx convention of the imported
// sources, no source file was edited to get there).
//
// 1 Nov, while fixing Batch B-E tests: the config was missing three facts about
// the environment these files actually run in, and each absence masqueraded as
// test-code errors: no DOM lib (tests and browser gates touch `document`,
// `window`, `HTMLSelectElement`), no JSX setting (the web component suites import
// `.tsx` panels through react-dom/server), and no type mappings for the packages
// pnpm keeps out of the root (`react`, `react-dom`, `pngjs` - their @types live
// under apps/web and apps/server). Those are now declared; nothing was relaxed to
// get there, and strictness is inherited from tsconfig.base.json unchanged.
//
// Measured on 1 Nov, in order: the batch that added Batch B-E work put the
// denominator at 311; declaring the three facts above took it to 278 with no
// source file touched; typing the Batch B-E tests and live-gate scripts (same
// day, see docs/KNOWN_ISSUES.md) took it to its current count. What still
// reports is in-test/script work, not configuration: partial fixtures against
// the full memory-record interfaces (TS2739/TS2741), strict undefined and
// index access (TS18048/TS2532), and the older phase-gate scripts.
// B-7 plan: fix tests/scripts against this config, then add a "typecheck:tests"
// script and a ci.yml step; decide whether partial fixtures get Partial<> types
// or explicit fields (the 87 TS2739s are a design call, not busywork).
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    // tests and web sources import some modules with explicit .ts specifiers
    // (vite/tsx convention); this check is noEmit-only, so accept them.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    // The environment these files really run in: vitest jsdom suites touch the DOM,
    // the browser gates evaluate DOM inside page.evaluate, and the React panel
    // suites render .tsx components. Without lib/jsx declared, every one of those
    // call sites reports a fake "error" in the test rather than a missing fact in
    // this config.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@mml/shared": ["./packages/shared/src/index.ts"],
      "@mml/memory-engine": ["./packages/memory-engine/src/index.ts"],
      "@mml/muse-provider": ["./packages/muse-provider/src/index.ts"],
      "@mml/tool-runtime": ["./packages/tool-runtime/src/index.ts"],
      "@mml/decision-guard": ["./packages/decision-guard/src/index.ts"],
      "@mml/mcp-server": ["./packages/mcp-server/src/index.ts"],
      "@mml/agent-core": ["./packages/agent-core/src/index.ts"],
      "@mml/ui-protocol": ["./packages/ui-protocol/src/index.ts"],
      "fastify": ["./apps/server/node_modules/fastify"],
      "fastify/*": ["./apps/server/node_modules/fastify/*"],
      // Same reason as the fastify mapping: pnpm keeps these out of the root, so
      // their declarations have to be named explicitly.
      "react": ["./apps/web/node_modules/@types/react"],
      "react/jsx-runtime": ["./apps/web/node_modules/@types/react/jsx-runtime.d.ts"],
      "react/jsx-dev-runtime": ["./apps/web/node_modules/@types/react/jsx-dev-runtime.d.ts"],
      "react-dom": ["./apps/web/node_modules/@types/react-dom"],
      "react-dom/server": ["./apps/web/node_modules/@types/react-dom/server.d.ts"],
      "pngjs": ["./apps/server/node_modules/@types/pngjs/index.d.ts"]
    }
  },
  "include": ["tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": [
    "**/dist/**",
    "node_modules",
    // Protocol-locked scripts assert their OWN bytes against hashes recorded in
    // the locked Phase 16/17 protocols (protocol.sha256 checks). Editing them -
    // even a type-only non-null assertion - breaks the research verification
    // chain (proven 31 Oct: patched bytes => "protocol.sha256: hash mismatch" =>
    // verify:research17 FAIL; revert => PASS). Their type errors are frozen
    // artifacts by design and permanently OUT OF SCOPE for B-7.
    "scripts/verify-phase16.ts",
    "scripts/verify-phase17.ts",
    "scripts/verify-phase17-sums.ts"
    // verify-phase17-strict.ts is ALSO protocol-locked but cannot be excluded:
    // tests/research/phase17-evidence.test.ts imports its closeRelative helper,
    // so it rides the import graph (17 errors in-scope-by-accident). Post-judging
    // B-7 option: carve the tested math into a shared module, then exclude the
    // locked script cleanly. Until then the denominator counts them knowingly.
  ]
}
