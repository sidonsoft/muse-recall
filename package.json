{
  "name": "muse-memory-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first memory companion for Meta Muse: persistent, correctable memory plus declarative generative UI.",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bench:context": "tsx scripts/benchmark-context-efficiency.ts",
    "bench:muse-overhead": "tsx scripts/benchmark-muse-overhead.ts",
    "bench:retrieval": "tsx scripts/benchmark-retrieval.ts",
    "build": "pnpm --filter @mml/web run build && pnpm --filter @mml/server run build",
    "db:migrate": "pnpm --filter @mml/server run db:migrate",
    "demo:seed": "tsx scripts/seed-forge-demo.ts",
    "demo:sessions": "tsx scripts/demo-sessions.ts",
    "demo:showcase": "tsx scripts/showcase.ts",
    "demo:tools": "tsx scripts/demo-tools.ts",
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @mml/server run dev",
    "dev:web": "pnpm --filter @mml/web run dev",
    "eval:comparison": "tsx scripts/evaluation-comparison.ts",
    "eval:guard": "tsx scripts/phase12e-guard-evaluation.ts",
    "eval:retrieval": "tsx scripts/evaluate-retrieval.ts",
    "evidence:guard-ui": "tsx scripts/phase12e-guard-ui-evidence.ts",
    "evidence:phase14a": "tsx scripts/phase14a-rehearsal.ts",
    "evidence:phase14a-ui": "tsx scripts/phase14a-demo-ui-evidence.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "muse:probe": "tsx scripts/probe-muse.ts",
    "start": "pnpm --filter @mml/server run start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "verify:browser": "tsx scripts/verify-ui.ts",
    "verify:forge": "tsx scripts/verify-forge.ts",
    "verify:runtime": "tsx scripts/verify-runtime.ts",
    "verify:security": "tsx scripts/verify-origin-guard.ts",
    "verify:research": "tsx scripts/verify-phase15b.ts",
    "verify:research16": "tsx scripts/verify-phase16.ts",
    "evidence:ux": "tsx scripts/ux-evidence.ts",
    "verify:formsandbox": "tsx scripts/verify-form-sandbox.ts",
    "verify:forge-workflow": "vitest run tests/integration/forge-api.test.ts",
    "verify:studio-workflow": "tsx scripts/verify-studio-workflow.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
