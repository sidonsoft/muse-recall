{
  "name": "muse-memory-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first memory companion for Meta Muse: persistent, correctable memory plus declarative generative UI.",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bench:context": "tsx scripts/benchmark-context-efficiency.ts",
    "bench:muse-overhead": "tsx scripts/benchmark-muse-overhead.ts",
    "bench:retrieval": "tsx scripts/benchmark-retrieval.ts",
    "build": "pnpm --filter @mml/web run build && pnpm --filter @mml/server run build",
    "db:backup": "pnpm --filter @mml/server run db:backup",
    "db:migrate": "pnpm --filter @mml/server run db:migrate",
    "db:restore": "pnpm --filter @mml/server run db:restore",
    "backup:drill": "pnpm --filter @mml/server run backup:drill",
    "ops:alert-prober": "pnpm --filter @mml/server run ops:alert-prober",
    "db:purge": "pnpm --filter @mml/server run db:purge",
    "demo:seed": "tsx scripts/seed-forge-demo.ts",
    "demo:sessions": "tsx scripts/demo-sessions.ts",
    "demo:showcase": "tsx scripts/showcase.ts",
    "demo:tools": "tsx scripts/demo-tools.ts",
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @mml/server run dev",
    "dev:web": "pnpm --filter @mml/web run dev",
    "eval:comparison": "tsx scripts/evaluation-comparison.ts",
    "eval:guard": "tsx scripts/phase12e-guard-evaluation.ts",
    "eval:retrieval": "tsx scripts/evaluate-retrieval.ts",
    "evidence:guard-ui": "tsx scripts/phase12e-guard-ui-evidence.ts",
    "evidence:phase14a": "tsx scripts/phase14a-rehearsal.ts",
    "evidence:phase14a-ui": "tsx scripts/phase14a-demo-ui-evidence.ts",
    "format": "biome format --write .",
    "mcp:serve": "node --import tsx packages/mcp-server/src/main.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "muse:probe": "tsx scripts/probe-muse.ts",
    "start": "pnpm --filter @mml/server run start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:tests && pnpm run test",
    "verify:browser": "tsx scripts/verify-ui.ts",
    "verify:fresh-install": "tsx scripts/verify-fresh-install.ts",
    "review:app": "tsx scripts/build-review-app.ts",
    "verify:first-run": "tsx scripts/verify-first-run.ts",
    "verify:forge": "tsx scripts/verify-forge.ts",
    "verify:runtime": "tsx scripts/verify-runtime.ts",
    "vendor:phaser": "tsx scripts/vendor-phaser.ts",
    "verify:security": "tsx scripts/verify-origin-guard.ts",
    "verify:research": "tsx scripts/verify-phase15b.ts",
    "verify:research16": "tsx scripts/verify-phase16.ts",
    "verify:research17": "tsx scripts/verify-phase17.ts && tsx scripts/verify-phase17-sums.ts && tsx scripts/verify-phase17-strict.ts",
    "verify:research17-pilot": "tsx scripts/verify-phase17.ts --pilot",
    "evidence:ux": "tsx scripts/ux-evidence.ts",
    "verify:formsandbox": "tsx scripts/verify-form-sandbox.ts",
    "verify:forge-workflow": "vitest run tests/integration/forge-api.test.ts",
    "verify:studio-workflow": "tsx scripts/verify-studio-workflow.ts",
    "media:backup": "pnpm --filter @mml/server run media:backup",
    "media:restore": "pnpm --filter @mml/server run media:restore",
    "media:drill": "pnpm --filter @mml/server run media:drill",
    "verify:media": "pnpm --filter @mml/server run verify:media",
    "verify:media-journey": "tsx scripts/verify-media-journey.ts",
    "verify:media-journey-offline": "MEDIA_JOURNEY_ASSET_SOURCE=upload tsx scripts/verify-media-journey.ts",
    "verify:media-live-smoke": "tsx scripts/verify-media-live-smoke.ts",
    "verify:batchc-live-smoke": "tsx scripts/verify-batchc-live-smoke.ts",
    "verify:batchc-resume-staged": "tsx scripts/verify-batchc-resume-staged.ts",
    "verify:batchd-playback-auth": "tsx scripts/verify-batchd-playback-auth.ts",
    "verify:batchd-live-smoke": "tsx scripts/verify-batchd-live-smoke.ts",
    "verify:image-live-smoke": "tsx scripts/verify-image-live-smoke.ts",
    "verify:review-live-smoke": "tsx scripts/verify-review-live-smoke.ts",
    "verify:batchc-ui": "tsx scripts/verify-batchc-ui.ts",
    "verify:batche-review-ui": "tsx scripts/verify-batche-review-ui.ts",
    "verify:artifact-probes": "tsx scripts/verify-artifact-probes.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.5",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
