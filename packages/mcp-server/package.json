    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mml/memory-engine": "workspace:*",
    "@mml/shared": "workspace:*",
    "@mml/tool-runtime": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.1.12"
  }
}
