{
  "name": "@mml/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP (stdio) surface for the shared tool contract: the same six bounded tools over the Model Context Protocol.",
  "exports": {
    ".": "./src/index.ts"
  },
