# dependencies
node_modules/
.pnpm-store/

# build output
dist/
dist-ssr/
build/
*.tsbuildinfo

# test output
coverage/
test-results/
playwright-report/
.vitest/

# local data (never commit a user's memory database)
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# environment / secrets
.env
.env.local
.env.*.local
!.env.example

# muse / agent scratch
.muse/
.agent-runs/
runs/

# editor & OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.log
# Evidence logs are deliberately part of the record (14 are tracked in
# docs/hackathon-evidence/**); without this negation, `git add -A` would
# silently SKIP new evidence logs added after this rule. Added 31 Oct after
# a tracked-vs-ignored census found exactly that trap; touches no tracked
# file's content.
!docs/hackathon-evidence/**/*.log

# Generated Forge game workspaces
apps/server/workspaces/
workspaces/

# python bytecode from the research verifiers
__pycache__/
*.pyc
